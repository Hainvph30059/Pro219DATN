@inherits LayoutComponentBase
@using Pro219.Web.Components.Common.User

@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<div class="relative">
    <Header />

    <main id="main_container" class="min-h-[calc(100lvh-31.625rem)] mt-20">
        @Body
    </main>

    <Footer />

    <MudScrollToTop TopOffset="100"
                    OnScroll="OnScroll"
                    Selector="#main_container"
                    VisibleCssClass="visible absolute"
                    HiddenCssClass="invisible">
        <MudIcon Icon="@Icons.Material.Filled.ArrowCircleUp" Size="@Size.Large" />
    </MudScrollToTop>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private void OnScroll()
    {
        
    }
}

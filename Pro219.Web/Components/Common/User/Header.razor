<header class="fixed left-0 right-0 top-0 flex h-20 bg-white px-10 py-2.5 shadow-lg">
    <nav class="flex h-full w-full items-center justify-between">
        <div class="max-h-16 max-w-48">
             <a href="@RouterConst.User.Home">
                <img src="/Assets/Icons/logo.svg" alt="logo" />
             </a>
        </div>

        <ul class="flex items-center gap-2">
            <li class="group relative mx-3 h-full hover:border-b hover:border-b-black">
                <a href="#" class="leading-[2.875rem] block text-base font-medium">TRANG CHỦ</a>
            </li>

            <li class="group relative mx-3 h-full hover:border-b hover:border-b-black">
                <a href="#" class="leading-[2.875rem] block text-base font-medium">ÁO THU ĐÔNG</a>

                <ul class="absolute hidden bg-white p-2.5 group-hover:block">
                    <li>
                        <a href="#" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Áo Nỉ / Thun Dài Tay</a>
                    </li>
                    <li>
                        <a href="#" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Áo Len</a>
                    </li>
                    <li>
                        <a href="#" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Áo Khoác</a>
                    </li>
                    <li>
                        <a href="#" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Cardigan</a>
                    </li>
                    <li>
                        <a href="#" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Áo Blazer / Măng Tô</a>
                    </li>
                    <li>
                        <a href="#" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Áo Hoodie</a>
                    </li>
                </ul>
            </li>

            <li class="group relative mx-3 h-full hover:border-b hover:border-b-black">
                <a href="#" class="leading-[2.875rem] block text-base font-medium">ÁO XUÂN HÈ</a>

                <ul class="absolute hidden bg-white p-2.5 group-hover:block">
                    <li>
                        <a href="#" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Áo Phông</a>
                    </li>
                    <li>
                        <a href="#" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Áo Sơ Mi Ngắn Tay</a>
                    </li>
                    <li>
                        <a href="#" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Áo Sơ Mi Dài Tay</a>
                    </li>
                    <li>
                        <a href="#" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Áo Polo</a>
                    </li>
                </ul>
            </li>

            <li class="group relative mx-3 h-full hover:border-b hover:border-b-black">
                <a href="#" class="leading-[2.875rem] block text-base font-medium">QUẦN</a>

                <ul class="absolute hidden bg-white p-2.5 group-hover:block">
                    <li>
                        <a href="#" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Quần Dài</a>
                    </li>
                    <li>
                        <a href="#" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Quần Cộc</a>
                    </li>
                </ul>
            </li>

            <li class="group relative mx-3 h-full hover:border-b hover:border-b-black">
                <a href="#" class="leading-[2.875rem] block text-base font-medium">THÔNG TIN</a>
            </li>
        </ul>

        <div class="flex items-center gap-3">
            <div class="flex items-center">
            <input placeholder="Tìm kiếm sản phẩm" class="!h-10 !w-56 rounded-e-none rounded-l-lg border-y border-l border-gray-300 px-2 outline-0" name="_searchValue" />
                <MudIcon Icon="@Icons.Material.Filled.Search" Size="@Size.Large" Class="!h-10 cursor-pointer rounded-r-lg border-y border-r border-gray-300 pr-2" />
            </div>
                
            <div class="group relative">
                @if (UserInfo != null)
                {
                    <MudAvatar Size="@Size.Medium" Class="cursor-pointer !bg-black !text-white" @onclick="HandleShowMenuChild">@UserInfo.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)[^1][0].ToString().ToUpper()</MudAvatar>

                    if(_isShowMenuChild)
                    {
                        <div class="absolute -right-[4.75rem] -top-[1.5rem] h-screen w-screen cursor-pointer bg-transparent" @onclick="HandleShowMenuChild"></div>
                        <ul class="absolute right-0 top-[120%] border border-slate-200 bg-white p-2 shadow-lg">
                            <li>
                                <a href="#" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Thông tin tài khoản</a>
                            </li>
                            <li>
                                <a href="#" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Giỏ Hàng</a>
                            </li>
                            <li>
                                <a href="#" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Yêu Thích</a>
                            </li>
                            <MudDivider />
                            <li>
                                <button @onclick="Logout" class="flex justify-start whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Đăng Xuất</button>
                            </li>
                        </ul>
                    }
                } else
                {
                    <a href="@RouterConst.User.Login">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="@Size.Medium" />
                    </a>
                }
            </div>

        <MudBadge Content="@_countCart" Color="Color.Error" Overlap="true" Bordered="true">
            <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="cursor-pointer" />
        </MudBadge>
        </div>
    </nav>
</header>

@code {
    [CascadingParameter(Name = Constant.CascadingNameParams.UserInfo)]
    public GetMeResponseDTO UserInfo { get; set; }

    [Parameter]
    public EventCallback OnLoggedOut { get; set; }

    [Parameter]
    public bool FirstLogin { get; set; }

    private string _searchValue = "";
    private int _countCart = 99;

    private bool _isShowMenuChild = false;

    private void HandleShowMenuChild()
    {
        if (FirstLogin) return;

        _isShowMenuChild = !_isShowMenuChild;
        StateHasChanged();
    }

    async Task Logout()
    {
        _isShowMenuChild = false;

        await OnLoggedOut.InvokeAsync();
    }
}
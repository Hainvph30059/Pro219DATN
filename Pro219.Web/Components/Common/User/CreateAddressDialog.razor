<MudDialog>
    <TitleContent>
        <MudText Style="font-size: 24px; font-weight: bold; text-transform: uppercase">Thêm địa chỉ mới</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Onsubmit" class="flex flex-col !gap-4">
             <DataAnnotationsValidator />

            <MudTextField @bind-Value="@_model.FullName" For="@(() => _model.FullName)" Variant="Variant.Outlined" Placeholder="Họ và tên" FullWidth="true" />
            <MudTextField @bind-Value="@_model.Phone" For="@(() => _model.Phone)" Class="mt-4 w-full" Variant="Variant.Outlined" Placeholder="Số điện thoại" FullWidth="true" />

            <MudSelect T="int" Value="@_selectedProvince" ValueChanged="OnProvinceChanged" Label="Tỉnh/Thành phố" Variant="Variant.Outlined">
                @if (_provinces.Any())
                {
                    <MudSelectItem Value="0">Vui lòng chọn</MudSelectItem>

                    foreach (var city in _provinces)
                    {
                        <MudSelectItem Value="@city.ProvinceID">@city.ProvinceName</MudSelectItem>
                    }
                }
            </MudSelect>

            <MudSelect T="int" Value="@_selectedDistrict" ValueChanged="OnDistrictChanged" Label="Quận/Huyện" Variant="Variant.Outlined" Disabled="@(!_districts.Any())">
                @if (_districts.Any())
                {
                    <MudSelectItem Value="0">Vui lòng chọn</MudSelectItem>

                    foreach (var city in _districts)
                    {
                        <MudSelectItem Value="@city.DistrictID">@city.DistrictName</MudSelectItem>
                    }
                }
            </MudSelect>

            <MudSelect T="int" @bind-Value="@_selectedWard" Label="Phường/Xã" Variant="Variant.Outlined" Disabled="@(!_wards.Any())">
                @if (_wards.Any())
                {
                    <MudSelectItem Value="0">Vui lòng chọn</MudSelectItem>

                    foreach (var city in _wards)
                    {
                        <MudSelectItem Value="@(int.Parse(city.WardCode))">@city.WardName</MudSelectItem>
                    }
                }
            </MudSelect>

            <MudTextField @bind-Value="@_model.OtherInfo" For="@(() => _model.OtherInfo)" Class="mt-4 w-full" Variant="Variant.Outlined" Placeholder="Địa chỉ chi tiết" FullWidth="true" />
            <MudCheckBox @bind-Value="@_model.IsDefault" For="@(() => _model.IsDefault)" Color="Color.Primary">Mặc Định</MudCheckBox>

            <div class="flex w-full items-center justify-end gap-2">
                <MudButton Color="MudBlazor.Color.Surface" ButtonType="ButtonType.Button" Variant="Variant.Outlined" OnClick="Cancel">Đóng</MudButton>
                <MudButton Color="MudBlazor.Color.Dark" ButtonType="ButtonType.Submit" Variant="Variant.Filled">Thêm mới</MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    List<ProvinceDTO> _provinces = [];
    List<DistrictDTO> _districts = [];
    List<WardDTO> _wards = [];
    GetMeResponseDTO _me = new GetMeResponseDTO();

    private int _selectedProvince = 0;
    private int _selectedDistrict = 0;
    private int _selectedWard = 0;
    private AddressModel _model = new AddressModel();

    protected override async Task OnInitializedAsync()
    {
        var resultMe = await localStorage.GetItemAsStringAsync(Constant.UserInfoLocalStorage);

        if (!string.IsNullOrEmpty(resultMe))
        {
            _me = JsonSerializer.Deserialize<GetMeResponseDTO>(resultMe);
        }

        var resProvince = await _addressService.GetAllProvince();

        if (resProvince.IsSuccess && resProvince.Data != null)
        {
            _provinces = resProvince.Data;
        }
    }

    private async Task OnProvinceChanged(int provinceId)
    {
        try
        {
            _selectedProvince = provinceId;
            _selectedDistrict = 0;
            _selectedWard = 0;
            var resDistrict = await _addressService.GetAllDistrictByProvinceId(provinceId);

            if (resDistrict.IsSuccess && resDistrict.Data != null)
            {
                _districts = resDistrict.Data;
            }
        } catch(Exception e) {}
    }

    private async Task OnDistrictChanged(int districtId)
    {
        try
        {
            _selectedDistrict = districtId;
            _selectedWard = 0;
            var resWard = await _addressService.GetAllWardByDistrictCode(districtId);

            if (resWard.IsSuccess && resWard.Data != null)
            {
                _wards = resWard.Data;
            }
        }
        catch (Exception e) { }
    }

    private async Task Onsubmit()
    {
        if (_selectedProvince == 0 || _selectedDistrict == 0 || _selectedWard == 0)
        {
            _snackbar.Add("Vui lòng nhập và chọn đầy đủ thông tin", Severity.Warning);
            return;
        }

        _model.CustomerId = _me.Id;
        _model.City = _selectedProvince.ToString();
        _model.District = _selectedDistrict.ToString();
        _model.Street = _selectedWard.ToString();

        var result = await _addressService.Create(_model);

        if (result.IsSuccess)
        {
            _snackbar.Add("Thêm địa chỉ thành công", Severity.Success);
            MudDialog.Cancel();
        } else
        {

            _snackbar.Add("Thêm địa chỉ thất bại", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
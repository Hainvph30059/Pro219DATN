@using Pro219.Web.DTOs
@using MudBlazor

@if(Item != null){
<div data-animation="1" class="group relative mb-10 lg:p-2.5">
    <div class="group relative overflow-hidden px-2.5 text-center">
        <a href="@RouterConst.User.Home" class="block transition">
            <picture class="flex h-full items-center justify-center transition duration-700 ease-in-out group-hover:invisible group-hover:opacity-0">
                <img class="overflow-clip" src="@Item?.Images[0]" />
            </picture>
            <picture class="invisible absolute bottom-0 left-0 right-0 top-0 flex items-center justify-center opacity-0 transition duration-700 ease-in-out group-hover:visible group-hover:opacity-100">
                    <img class="overflow-clip" src="@Item?.Images[1]" />
            </picture>
        </a>
    </div>

        <div class="my-2.5 flex w-full justify-center gap-1">
            @if (Item.Colors != null && Item.Colors.Any())
            {
                <div class="my-2.5 flex w-full justify-center gap-1">
                    @foreach (var c in Item.Colors)
                    {
                        <MudTooltip Text="@c.Name" Arrow="true" Placement="Placement.Top">
                            <div class="h-6 w-6 cursor-pointer rounded-full border border-gray-300 shadow-sm"
                                 style="background-color: @c.HexCode">
                            </div>
                        </MudTooltip>
                    }
                </div>
            }
        </div>

    <div class="w-full">
        <p class="line-clamp-1 text-center text-sm">@Item.ProductName</p>
    </div>

    <div class="w-full">
        <p class="line-clamp-1 text-center text-sm font-bold">@Item.Price.ToString("C", vietnameseCulture)</p>
    </div>

    <div class="invisible absolute -bottom-10 left-0 z-10 flex w-full items-center justify-between gap-4 bg-black py-2.5 opacity-0 group-hover:visible group-hover:opacity-100">
        <a class="flex w-[49%] justify-center text-white"><MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small" Class="!mr-1" /> Mua nhanh</a>
        <div class="h-5 w-[2%] border-r border-white" />
            <a href="/Product/detail/@Item.Id" class="flex w-[49%] justify-center text-white"><MudIcon Icon="@Icons.Material.Filled.RemoveRedEye" Size="Size.Small" Class="!mr-1" /> Xem chi tiết</a>
    </div>
    </div>
}
else
{
    <div class="mb-10 lg:p-2.5">
        <MudSkeleton SkeletonType = "SkeletonType.Rectangle" Width="100%" Height="300px" Class="p-2.5" />
        <div class="my-2.5 flex w-full justify-center gap-1">
            <MudSkeleton SkeletonType = "SkeletonType.Circle" Width="24px" Height="24px" />
            <MudSkeleton SkeletonType = "SkeletonType.Circle" Width="24px" Height="24px" />
            <MudSkeleton SkeletonType = "SkeletonType.Circle" Width="24px" Height="24px" />
        </div>
        <div class="w-full">
            <MudSkeleton SkeletonType = "SkeletonType.Text" Width="80%" Class="mx-auto text-center" />
        </div>
        <div class="w-full">
            <MudSkeleton SkeletonType = "SkeletonType.Text" Width="40%" Class="mx-auto text-center" />
        </div>
    </div>
}
@code {
    [Parameter]
    public ProductShowDto? Item { get; set; } = null!;

    CultureInfo vietnameseCulture = new CultureInfo("vi-VN");
}

<style>
    .custom-text a div,
    .custom-text a svg path {
        color: #FFFFFF;
    }
</style>

<nav class="relative h-full w-[18.75rem] pb-4 pt-6 shadow-lg">
    <MudNavMenu Class="mud-width-full" Color="Color.Primary" Bordered="true">
        <a href="@RouterConst.Admin.Home" class="flex w-full items-center justify-center px-10">
            <img src="/Assets/Icons/logo-admin.svg" alt="logo" />
        </a>

        <MudDivider Class="my-5 !border-slate-200" />

        <div class="max-h-[calc(100lvh-15.5rem)] flex flex-col gap-2 overflow-y-auto px-3">
            <MudNavLink Href="@RouterConst.Admin.Home" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Home">Trang chủ</MudNavLink>
            <MudNavLink Href="@RouterConst.Admin.Product" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AllInbox">Sản phẩm</MudNavLink>
            <MudNavLink Href="@RouterConst.Admin.Coupon" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PanoramaHorizontalSelect">Mã giảm giá</MudNavLink>
            <MudNavLink Href="@RouterConst.Admin.Sale" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PanoramaHorizontalSelect">Giảm giá</MudNavLink>
            <MudNavLink Href="@RouterConst.Admin.Category" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category">Danh mục</MudNavLink>
            <MudNavLink Href="@RouterConst.Admin.Brand" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AutoAwesome">Thương hiệu</MudNavLink>
            <MudNavLink Href="@RouterConst.Admin.Color" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Style">Màu</MudNavLink>
            <MudNavLink Href="@RouterConst.Admin.Size" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.BorderColor">Kích cỡ</MudNavLink>
            <MudNavLink Href="@RouterConst.Admin.Bill" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Payments">Hóa đơn</MudNavLink>
            <MudNavLink Href="@RouterConst.Admin.Statistical" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SsidChart">Thống kê</MudNavLink>
            <MudNavLink Href="@RouterConst.Admin.Customer" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Group">Tài khoản khách hàng</MudNavLink>
            <MudNavLink Href="@RouterConst.Admin.User" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SupervisedUserCircle">Tài quản trị</MudNavLink>
        </div>
    </MudNavMenu>

    <div class="absolute bottom-4 left-0 right-0">
        <MudDivider Class="my-5 !border-slate-200" />

        <div class="relative px-3">
            <div class="flex cursor-pointer items-center gap-2 rounded-xl p-2 hover:bg-gray-100" @onclick="HandleShowMenuChild">
                <MudAvatar Size="@Size.Medium" Class="!bg-admin-default !font-bold !text-white">A</MudAvatar>
                <p class="line-clamp-1 text-base font-medium text-[#252a2b]">Adams Store Management</p>
            </div>
        </div>

        @if (_isShowMenuChild)
        {
            <div class="-top-[calc(100vh-7.0625rem)] absolute h-screen w-screen cursor-pointer bg-transparent" @onclick="HandleShowMenuChild"></div>
            <div class="absolute bottom-0 left-full w-full min-w-40 bg-transparent">
                <ul class="ml-4 w-full bg-white py-2">
                    <li class="px-3">
                        <MudAvatar Size="@Size.Small" Class="!bg-admin-default !text-white">A</MudAvatar>
                    </li>
                    <li class="mt-2 px-3">
                        <p class="whitespace-nowrap text-sm font-medium text-[#252a2b]">Adams Store</p>
                    </li>
                    <MudDivider Class="my-3 !border-slate-200" />
                    <li class="px-3">
                        <button @onclick="Logout" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:bg-gray-100 hover:text-black">Đăng Xuất</button>
                    </li>
                </ul>
            </div>
        }
    </div>
</nav>

@code {
    private bool _isShowMenuChild = false;

    private void HandleShowMenuChild()
    {
        _isShowMenuChild = !_isShowMenuChild;
        StateHasChanged();
    }

    async Task Logout()
    {
        await localStorage.RemoveItemAsync(Constant.TokenNameLocalStorage);
        await localStorage.RemoveItemAsync(Constant.TokenExpiredLocalStorage);

        navigation.NavigateTo(RouterConst.Admin.Login);
    }
}

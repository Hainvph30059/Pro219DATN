@page "/"
@layout MainLayout

<PageTitle>@Constant.PageTitleUser Home</PageTitle>


<section class="mx-auto w-full max-w-[120rem]">
    <img  src="/Assets/Images/user-home-banner-1.png" alt="banner" />
</section>

<section class="my-8 px-0 pt-8 lg:px-8">
    <h2 class="text-center text-xl font-bold uppercase md:text-2xl lg:text-3xl">Sản phẩm mới</h2>
    <div class="mt-8 grid gap-2 px-4 xs:grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 sm:px-2">
        @for(var i = 0; i < 8; i++)
        {
            <ProductItem />
        }
    </div>
</section>

<section class="my-8 px-0 pt-8 lg:px-8">
    <h2 class="text-center text-xl font-bold uppercase md:text-2xl lg:text-3xl">Sản phẩm bán chạy</h2>
    <div class="mt-8 grid grid-cols-4 gap-2 px-4 xs:grid-cols-1 sm:grid-cols-2 md:grid-cols-3 sm:px-2">
        @for (var i = 0; i < 8; i++)
        {
            <ProductItem />
        }
    </div>
</section>

<section class="mx-auto my-8 w-full max-w-[120rem]">
    <img src="/Assets/Images/user-home-banner-2.jpg" alt="banner" />
</section>
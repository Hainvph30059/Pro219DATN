@page "/product/detail/{Id:int}"
@layout MainLayout
@inject ISnackbar Snackbar
@inject ProductService ProductService
@using Pro219.Web.DTOs
@using MudBlazor

<PageTitle>@Constant.PageTitleUser @(_product?.ProductName ?? "Chi tiết sản phẩm")</PageTitle>

@if (_product == null)
{
    <div class="d-flex justify-center mt-10">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </div>
}
else
{
    <section class="mx-auto mb-10 mt-4 w-full max-w-screen-xl">
        <div class="mt-2 flex h-full w-full flex-col gap-4 md:flex-row lg:flex-row">
            <div class="w-full md:w-[calc(100%-27rem)] lg:w-[calc(100%-27rem)]">
                <MudCarousel Class="mud-width-full !aspect-square" ShowBullets="true" AutoCycle="false" TData="string">
                    @foreach (var img in _product.Images)
                    {
                        <MudCarouselItem>
                            <div class="d-flex" style="height:100%">
                                <img src="@img" alt="@_product.ProductName" class="mx-auto my-auto object-contain h-full w-full" />
                            </div>
                        </MudCarouselItem>
                    }
                </MudCarousel>
            </div>
            <div class="h-fit w-full flex-shrink-0 p-3 shadow md:w-[26rem] lg:w-[26rem]">
                <h1 class="mb-2 text-base font-medium">@_product.ProductName</h1>
                @if (IsOutOfStock())
                {
                    <span class="text-sm font-medium text-red-500">Hết hàng</span>
                }
                else
                {
                    <span class="text-sm font-medium text-green-600">Còn hàng</span>
                }

                <MudDivider Class="!my-2.5 !border-dotted" />

                <span class="text-xl font-bold">
                    @FormatCurrency(_currentPrice)
                </span>

                <div class="mt-2">
                    <p class="mb-2 text-sm font-medium uppercase">Màu sắc:  <span class="font-bold">@_selectedColorName</span></p>
                    <div class="flex flex-wrap items-center gap-2">
                        @foreach (var color in _product.UniqueColors)
                        {
                            <button @onclick="() => SelectColor(color)"
                                 class="h-9 w-9 rounded-full cursor-pointer border border-slate-400"
                                 style="background-color: @color.HexCode;">
                            </button>
                        }
                    </div>
                </div>

                <div class="mt-2">
                    <p class="mb-2 text-sm font-medium uppercase">Kích thước</p>
                    <div class="flex flex-wrap items-center gap-2">
                        @foreach (var size in _product.UniqueSizes)
                        {
                            var isAvaliable = IsSizeAvailableForColor(size.Id);
                            <button @onclick="() => SelectSize(size.Id)"
                                    disabled="@isAvaliable"
                                    class="flex h-9 w-9 items-center justify-center border @(GetSizeClass(size.Id))">
                                @size.Name
                            </button>
                        }
                    </div>
                </div>

                <div class="my-4 flex">
                    <MudIconButton Class="!flex !h-[1.875rem] !w-[1.875rem] !cursor-pointer !items-center !justify-center" @onclick="DecreaseQuantity" Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Disabled="@((_quantity == 1) || (_selectedColorId == 0 && _selectedSizeId == 0))" />
                    
                    <span class="flex h-[1.875rem] w-10 items-baseline justify-center border bg-gray-50 p-1">@_quantity</span>

                    <MudIconButton Class="!flex !h-[1.875rem] !w-[1.875rem] !cursor-pointer !items-center !justify-center" @onclick="IncreaseQuantity" Icon="@Icons.Material.Filled.Add" Size="Size.Small" Disabled="@(_selectedColorId == 0 && _selectedSizeId == 0)" />
                </div>

                <div class="flex justify-between">
                    <button class="w-[49%] bg-black py-3 uppercase text-white">Thêm Giỏ Hàng</button>
                    <button class="w-[49%] bg-black py-3 uppercase text-white">Mua Ngay</button>
                </div>

                <div class="mt-2">
                    <button class="w-full border border-solid border-slate-200 py-3"><MudIcon Icon="@Icons.Material.Filled.FavoriteBorder" /> Yêu Thích</button>
                </div>
            </div>
        </div>
    </section>

    
}

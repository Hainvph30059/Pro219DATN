@page "/login"
@layout MainLayout

<PageTitle>@Constant.PageTitleUser Login</PageTitle>

<section class="mx-auto my-6 w-full max-w-[30rem] rounded-lg border border-gray-200 px-4 py-6">
    <h1 class="text-xl font-bold uppercase">Đăng Nhập Tài Khoản</h1>

    <p class="mt-1 text-sm font-medium text-[#666666]">Nhập email và mật khẩu của bạn:</p>

    <MudDivider Class="!my-4"/>

    <EditForm class="w-full" Model="@_model" OnValidSubmit="OnLogin">
        <DataAnnotationsValidator />

        <MudTextField @bind-Value="@_model.Username" For="@(() => _model.Username)" Class="w-full" Placeholder="Email" Variant="Variant.Outlined" FullWidth="true" />
        <MudTextField @bind-Value="@_model.Password" For="@(() => _model.Password)" Class="mb-2 mt-4 w-full" Placeholder="Mật khẩu" Variant="Variant.Outlined" InputType="@PasswordInput" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon" OnAdornmentClick="ShowHidePassword" AdornmentAriaLabel="Show Password" FullWidth="true" />

        <div class="mb-4">
            <a href="@RouterConst.User.ForgotPassword" class="text-xs font-medium text-[#252a2b]">Quên mật khẩu?</a>
        </div>

        <MudButton Class="!h-12 w-full rounded-lg !bg-black !text-white" ButtonType="ButtonType.Submit">Đăng Nhập</MudButton>
    </EditForm>

    <div class="mt-4 flex items-center gap-2">
        <span class="text-sm text-[#666666]">Thành viên mới?</span>
        <a href="@RouterConst.User.SignUp" class="text-sm font-medium text-[#252a2b]">Đăng ký tài khoản</a>
    </div>
</section>

@code {
    AuthSchema.LoginSchema _model = new AuthSchema.LoginSchema();
    private bool _isPasswordVisible = false;

    [Inject] ISnackbar Snackbar { get; set; }

    InputType PasswordInput => _isPasswordVisible ? InputType.Text : InputType.Password;
    string PasswordInputIcon => _isPasswordVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;

    void ShowHidePassword()
    {
        _isPasswordVisible = !_isPasswordVisible;
        StateHasChanged();
    }

    async Task OnLogin()
    {
        var response = await  _accountService.LoginCustomer(_model.Username, _model.Password);
        if (response.LoginSuccess ==true)
        {
            Snackbar.Add("Đăng nhập thành công!", Severity.Success);            
            navigation.NavigateTo(RouterConst.User.Home, true);
            await localStorage.SetItemAsync(Constant.TokenNameLocalStorage, response.Token);
            await localStorage.SetItemAsync(Constant.TokenExpiredLocalStorage, response.Expiration);
            
        }
        else
        {
            Snackbar.Add("Đăng nhập không thành công. Vui lòng kiểm tra lại tên người dùng và mật khẩu.", Severity.Warning);
        }

    }
}
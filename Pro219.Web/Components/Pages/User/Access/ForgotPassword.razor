@page "/forgot-password"
@layout MainLayout

<PageTitle>@Constant.PageTitleUser Forgot Password</PageTitle>

<section class="mx-auto my-6 w-full max-w-[30rem] rounded-lg border border-gray-200 px-4 py-6">
    <h1 class="text-xl font-bold uppercase">Quên mật khẩu</h1>

    <p class="mt-1 text-sm font-medium text-[#666666]">Nhập email để khôi phục mật khẩu:</p>

    <MudDivider Class="!my-4" />

    <MudTextField T="string" @bind-Value="_email" Class="mb-4 w-full" Placeholder="Email/Số điện thoại" Variant="Variant.Outlined" FullWidth="true"></MudTextField>

    <MudButton Class="!h-12 w-full rounded-lg !bg-black !text-white">Gửi</MudButton>

    <div class="mt-4 flex items-center gap-2">
        <span class="text-sm text-[#666666]">Đã có tài khoản?</span>
        <a href="@RouterConst.User.Login" class="text-sm font-medium text-[#252a2b]">Đăng nhập ngay</a>
    </div>

    <div class="mt-1 flex items-center gap-2">
        <span class="text-sm text-[#666666]">Thành viên mới?</span>
        <a href="@RouterConst.User.SignUp" class="text-sm font-medium text-[#252a2b]">Đăng ký tài khoản</a>
    </div>
</section>

@code {
    private string _email;
}
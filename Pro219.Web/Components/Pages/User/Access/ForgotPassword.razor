@page "/forgot-password"
@layout MainLayout

@using System.ComponentModel.DataAnnotations;
@using Pro219.Web.Constants;

<PageTitle>@Constant.PageTitleUser Forgot Password</PageTitle>

<section class="mx-auto my-6 w-full max-w-[30rem] rounded-lg border border-gray-200 px-4 py-6">
    <h1 class="text-xl font-bold uppercase">Quên mật khẩu</h1>

    <p class="mt-1 text-sm font-medium text-[#666666]">Nhập email hoặc số điện thoại để khôi phục mật khẩu:</p>

    <MudDivider Class="!my-4" />

    <EditForm Model="_model" OnValidSubmit="OnSubmit">
        <DataAnnotationsValidator />

        <MudTextField T="string" @bind-Value="@_model.Email" For="@(() => _model.Email)" Class="mb-4 w-full" Placeholder="Nhập email hoặc số điện thoại của bạn" Variant="Variant.Outlined" FullWidth="true"></MudTextField>

        <MudButton Class="!h-12 w-full rounded-lg !bg-black !text-white" ButtonType="@ButtonType.Submit">Gửi</MudButton>
    </EditForm>

    <div class="mt-4 flex items-center gap-2">
        <span class="text-sm text-[#666666]">Đã có tài khoản?</span>
        <a href="@RouterConst.User.Login" class="text-sm font-medium text-[#252a2b]">Đăng nhập ngay</a>
    </div>

    <div class="mt-1 flex items-center gap-2">
        <span class="text-sm text-[#666666]">Thành viên mới?</span>
        <a href="@RouterConst.User.SignUp" class="text-sm font-medium text-[#252a2b]">Đăng ký tài khoản</a>
    </div>
</section>

@code {
    ForgotModel _model = new ForgotModel();

    async Task OnSubmit()
    {
        var response = await _authService.ForgotPassword(_model.Email);
        if (response.isSuccess == true)
        {
            _snackbar.Add("Nếu địa chỉ email bạn vừa cung cấp tồn tại trong hệ thống của chúng tôi, một email chứa mật khẩu mới đã được gửi đi.", Severity.Success);
            navigation.NavigateTo(RouterConst.User.Login);

        }
        else
        {
            if (response.StatusCode == Constant.ErrorSatusCode.Internal || response.StatusCode == Constant.ErrorSatusCode.BadRequest)
            {     
                var errorMess = Constant.Errors[response.Code];
                _snackbar.Add(errorMess != null ? errorMess : "Đăng nhập không thành công!", Severity.Warning);
            } else
            {
                _snackbar.Add("Nếu địa chỉ email bạn vừa cung cấp tồn tại trong hệ thống của chúng tôi, một email chứa mật khẩu mới đã được gửi đi.", Severity.Success);
                navigation.NavigateTo(RouterConst.User.Login);
            }
        }
    }

    private class ForgotModel
    {
        [Required(ErrorMessage = Constant.MessageValid.Required)]
        [MaxLength(100, ErrorMessage = Constant.MessageValid.Max100)]
        [EmailAddress(ErrorMessage = Constant.MessageValid.Email)]
        public string Email { get; set; }
    }
}
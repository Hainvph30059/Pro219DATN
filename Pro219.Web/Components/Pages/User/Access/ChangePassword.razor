@page "/change-password"
@layout MainLayout

<PageTitle>@Constant.PageTitleUser Reset Password</PageTitle>

<section class="mx-auto my-6 w-full max-w-[30rem] rounded-lg border border-gray-200 px-4 py-6">
    <h1 class="text-xl font-bold uppercase">Đổi Mật Khẩu</h1>

    <p class="mt-1 text-sm font-medium text-[#666666]">Nhập mật khẩu hiện tại và mật khẩu mới của bạn:</p>

    <MudDivider Class="!my-4" />

    <EditForm class="flex w-full flex-col gap-4" Model="_model" OnValidSubmit="OnSubmit">
        <DataAnnotationsValidator />

        <MudTextField @bind-Value="@_model.CurrentPassword" For="@(() => _model.CurrentPassword)" Placeholder="Mật khẩu hiện tại" Variant="Variant.Outlined" InputType="@PasswordInputCurrent" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIconCurrent" OnAdornmentClick="ShowHidePasswordCurrent" AdornmentAriaLabel="Show Password" FullWidth="true" />
        <MudTextField @bind-Value="@_model.NewHashPassword" For="@(() => _model.NewHashPassword)" Placeholder="Mật khẩu mới" Variant="Variant.Outlined" InputType="@PasswordInputNew" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIconNew" OnAdornmentClick="ShowHidePasswordNew" AdornmentAriaLabel="Show Password" FullWidth="true" />

        <MudButton Class="!h-12 w-full rounded-lg !bg-black !text-white" ButtonType="ButtonType.Submit">Gửi</MudButton>
    </EditForm>
</section>

@code {
    ChangePasswordModel _model = new ChangePasswordModel();

    private bool _isPasswordVisibleCurrent = false;
    private bool _isPasswordVisibleNew = false;
    private string _token = string.Empty;

    InputType PasswordInputCurrent => _isPasswordVisibleCurrent ? InputType.Text : InputType.Password;
    InputType PasswordInputNew => _isPasswordVisibleNew ? InputType.Text : InputType.Password;
    string PasswordInputIconCurrent => _isPasswordVisibleCurrent ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    string PasswordInputIconNew => _isPasswordVisibleNew ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            _token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);

            var FirstLogin = await localStorage.GetItemAsStringAsync(Constant.UserFirstLoginLocalStorage);

            if(string.IsNullOrEmpty(FirstLogin))
            {
                navigation.NavigateTo(RouterConst.User.Home);
            } else
            {
                if(!bool.Parse(FirstLogin))
                {
                    navigation.NavigateTo(RouterConst.User.Home);
                }
            }
        }
    }

    void ShowHidePasswordCurrent()
    {
        _isPasswordVisibleCurrent = !_isPasswordVisibleCurrent;
        StateHasChanged();
    }

    void ShowHidePasswordNew()
    {
        _isPasswordVisibleNew = !_isPasswordVisibleNew;
        StateHasChanged();
    }

    async Task OnSubmit()
    {
        var response = await _authService.ChangePassword(_model, _token);

        if (response.isSuccess == true)
        {
            await localStorage.RemoveItemAsync(Constant.UserFirstLoginLocalStorage);
            await localStorage.SetItemAsync(Constant.UserFirstLoginLocalStorage, false);

            _snackbar.Add("Đổi mật khẩu thành công", Severity.Success);
            navigation.NavigateTo(RouterConst.User.Home);

        }
        else
        {
            var errorMess = Constant.Errors[response.Code];
            _snackbar.Add(errorMess != null ? errorMess : "Đổi mật khẩu thất bại", Severity.Warning);
        }
    }
}
@page "/checkout/{id:int}/failed"
@layout MainLayout

<section class="mx-auto w-full max-w-[1032px] pb-10 pt-4">
    <div class="flex w-full flex-col items-center justify-center gap-4 rounded-lg border border-solid border-slate-200 p-6 text-center shadow">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="!text-4xl" />
        <h2 class="text-2xl font-bold text-red-600">Đặt hàng thất bại!</h2>
        <div class="flex justify-center gap-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => navigation.NavigateTo(RouterConst.User.Home))">trang chủ</MudButton>
        </div>
    </div>
</section>

@code {
    private int _orderIdSuccess = -1;
    private string _orderCodeSuccess = string.Empty;
}

@page "/admin/login"
@layout PublicLayout

<PageTitle>@Constant.PageTitleAdmin Login</PageTitle>

<section class="flex h-full w-full flex-col items-center justify-center gap-10 bg-[#7e6fff]">
    <div class="flex w-full max-w-[35rem] flex-col items-center justify-center rounded-lg bg-white p-12 shadow-2xl">
        <div class="flex w-64 items-center justify-center">
            <img src="/Assets/Icons/logo-admin.svg" alt="logo" />
        </div>

        <h2 class="mb-6 mt-2 text-2xl font-bold text-[#252a2b]">Welcome to Adams Store Management</h2>

        <EditForm class="w-full" Model="_model" OnValidSubmit="OnLogin">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="_model.Username" For="@(() => _model.Username)" Variant="Variant.Outlined" Placeholder="Email" FullWidth="true" />

            <MudTextField @bind-Value="_model.Password" For="@(() => _model.Password)" Class="mt-4 w-full" Variant="Variant.Outlined" Placeholder="Password" InputType="@PasswordInput" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon" OnAdornmentClick="ShowHidePassword" AdornmentAriaLabel="Show Password" FullWidth="true" />

            <MudButton Class="mt-6 !h-12 !w-full rounded-lg !bg-[#7e6fff] !text-white" ButtonType="ButtonType.Submit">Đăng Nhập</MudButton>
        </EditForm>
    </div>
</section>

@code {
    AuthSchema.LoginSchema _model = new AuthSchema.LoginSchema();
    private bool _isPasswordVisible = false;
    private bool _isLoading = false;

    [Inject] ISnackbar Snackbar { get; set; }

    InputType PasswordInput => _isPasswordVisible ? InputType.Text : InputType.Password;
    string PasswordInputIcon => _isPasswordVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);

            if (token != null && token != "")
            {
                navigation.NavigateTo(RouterConst.Admin.Home, true);
            }
        }
    }

    void ShowHidePassword()
    {
        _isPasswordVisible = !_isPasswordVisible;
        StateHasChanged();
    }

    async Task OnLogin()
    {
        var response = await _authService.LoginStaff(_model.Username, _model.Password);
        if (response.LoginSuccess == true)
        {
            Snackbar.Add("Đăng nhập thành công!", Severity.Success);
            navigation.NavigateTo(RouterConst.Admin.Home, true);
            await localStorage.SetItemAsync(Constant.TokenNameLocalStorage, response.Token);
            await localStorage.SetItemAsync(Constant.TokenExpiredLocalStorage, response.Expiration);

        }
        else
        {
            Snackbar.Add("Đăng nhập không thành công. Vui lòng kiểm tra lại tên người dùng và mật khẩu.", Severity.Warning);
        }

    }
}
